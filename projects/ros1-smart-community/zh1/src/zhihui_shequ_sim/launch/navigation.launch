<?xml version="1.0"?>
<launch>
  <arg name="gui" default="true"/>
  <arg name="paused" default="false"/>
  <arg name="use_rviz" default="true"/>
  <arg name="map_file" default="$(find zhihui_shequ_sim)/maps/smart_community.yaml"/>
  <arg name="initial_pose_x" default="4.15"/>
  <arg name="initial_pose_y" default="3.65"/>
  <arg name="initial_pose_a" default="3.14159"/>

  <include file="$(find zhihui_shequ_sim)/launch/simulation.launch">
    <arg name="gui" value="$(arg gui)"/>
    <arg name="paused" value="$(arg paused)"/>
    <arg name="run_mission" value="false"/>
    <arg name="show_camera_window" value="false"/>
  </include>

  <node pkg="map_server"
        type="map_server"
        name="map_server"
        args="$(arg map_file)"
        output="screen"/>

  <node pkg="amcl"
        type="amcl"
        name="amcl"
        output="screen">
    <rosparam file="$(find zhihui_shequ_sim)/config/amcl_params.yaml" command="load"/>
    <param name="base_frame_id" value="base_footprint"/>
    <param name="odom_frame_id" value="odom"/>
    <param name="global_frame_id" value="map"/>
    <param name="scan_topic" value="/scan"/>
    <param name="initial_pose_x" value="$(arg initial_pose_x)"/>
    <param name="initial_pose_y" value="$(arg initial_pose_y)"/>
    <param name="initial_pose_a" value="$(arg initial_pose_a)"/>
  </node>

  <node pkg="move_base"
        type="move_base"
        name="move_base"
        output="screen">
    <rosparam file="$(find zhihui_shequ_sim)/config/costmap_common_params.yaml" command="load" ns="global_costmap"/>
    <rosparam file="$(find zhihui_shequ_sim)/config/costmap_common_params.yaml" command="load" ns="local_costmap"/>
    <rosparam file="$(find zhihui_shequ_sim)/config/global_costmap_params.yaml" command="load"/>
    <rosparam file="$(find zhihui_shequ_sim)/config/local_costmap_params.yaml" command="load"/>
    <rosparam file="$(find zhihui_shequ_sim)/config/base_local_planner_params.yaml" command="load"/>
    <rosparam file="$(find zhihui_shequ_sim)/config/move_base_params.yaml" command="load"/>
  </node>

  <node if="$(arg use_rviz)"
        pkg="rviz"
        type="rviz"
        name="rviz"
        args="-d $(find zhihui_shequ_sim)/rviz/navigation.rviz"/>
</launch>
