<launch>
     <include file="$(find ceshi3)/launch/map_server.launch" />
     <param name="robot_description"
       command="xacro $(find ceshi3)/xacro/robot.xacro" />
    <!-- 启动AMCL节点 -->
    <include file="$(find ceshi3)/launch/amcl.launch" />

    <!-- 运行move_base节点 -->
    <include file="$(find ceshi3)/launch/path.launch" />
    <!-- 运行rviz -->
    <node pkg="rviz" type="rviz" name="rviz" args="-d $(find ceshi3)/config/nav.rviz"/>
    <node pkg="joint_state_publisher"
      name="joint_state_publisher"
      type="joint_state_publisher" />
    <node pkg="robot_state_publisher" name="robot_state_publisher" type="robot_state_publisher" />
</launch>
