  "launch_files": {
    "robot.launch": "<launch>\n\n    <!-- 将 Urdf 文件的内容加载到参数服务器 -->\n    <param name=\"robot_description\" command=\"xacro $(find ceshi3)/xacro/robot.xacro\" />\n    <!-- 启动 gazebo -->\n    <include file=\"$(find gazebo_ros)/launch/empty_world.launch\">\n        <arg name=\"world_name\" value=\"$(find ceshi3)/worlds/15.world\" />\n    </include>\n\n    <!-- 在 gazebo 中显示机器人模型 -->\n    <node pkg=\"gazebo_ros\" type=\"spawn_model\" name=\"model\"\n          args=\"-urdf -model mycar -param robot_description -x 1.649 -y 1.670 -z 0.25 -Y 3.113\" />\n</launch>\n",
    "nav.launch": "<launch>\n     <include file=\"$(find ceshi3)/launch/map_server.launch\" />\n     <param name=\"robot_description\"\n       command=\"xacro $(find ceshi3)/xacro/robot.xacro\" />\n    <!-- 启动AMCL节点 -->\n    <include file=\"$(find ceshi3)/launch/amcl.launch\" />\n\n    <!-- 运行move_base节点 -->\n    <include file=\"$(find ceshi3)/launch/path.launch\" />\n    <!-- 运行rviz -->\n    <node pkg=\"rviz\" type=\"rviz\" name=\"rviz\" args=\"-d $(find ceshi3)/config/nav.rviz\"/>\n    <node pkg=\"joint_state_publisher\"\n      name=\"joint_state_publisher\"\n      type=\"joint_state_publisher\" />\n    <node pkg=\"robot_state_publisher\" name=\"robot_state_publisher\" type=\"robot_state_publisher\" />\n</launch>\n",
    "patrol_with_vision.launch": "<launch>\n  <arg name=\"image_topic\" default=\"/camera/image_raw\" />\n  <arg name=\"traffic_light_model\" default=\"/home/ros1/桌面/best_ros2.onnx\" />\n  <node pkg=\"ceshi3\" type=\"patrol_with_vision.py\" name=\"ceshi3_patrol_with_vision\" output=\"screen\" required=\"true\">\n    <param name=\"image_topic\" value=\"$(arg image_topic)\" />\n    <param name=\"traffic_light_model\" value=\"$(arg traffic_light_model)\" />\n    <param name=\"ocr_min_score\" value=\"0.50\" />\n    <param name=\"ocr_worker_timeout\" value=\"120.0\" />\n    <rosparam param=\"plate_aliases\">{\"苏W·GT88V\": \"苏W·GT88V\"}</rosparam>\n  </node>\n</launch>\n"
  },
