<launch><arg name="map_file" default="$(find community_slam)/maps/smart_community.yaml"/><arg name="initial_pose_x" default="4.15"/><arg name="initial_pose_y" default="3.65"/><arg name="initial_pose_a" default="3.14159"/><node pkg="map_server" type="map_server" name="map_server" args="$(arg map_file)" output="screen"/><node pkg="amcl" type="amcl" name="amcl" output="screen"><rosparam file="$(find community_slam)/config/amcl.yaml" command="load"/><param name="base_frame_id" value="base_footprint"/><param name="odom_frame_id" value="odom"/><param name="global_frame_id" value="map"/><param name="scan_topic" value="/scan"/><param name="initial_pose_x" value="$(arg initial_pose_x)"/><param name="initial_pose_y" value="$(arg initial_pose_y)"/><param name="initial_pose_a" value="$(arg initial_pose_a)"/></node></launch>
