<launch><arg name="gui" default="true"/><arg name="paused" default="false"/><arg name="use_rviz" default="true"/><include file="$(find community_gazebo)/launch/simulation.launch"><arg name="gui" value="$(arg gui)"/><arg name="paused" value="$(arg paused)"/><arg name="run_perception" value="false"/></include><node pkg="gmapping" type="slam_gmapping" name="slam_gmapping" output="screen"><rosparam file="$(find community_slam)/config/gmapping.yaml" command="load"/><remap from="scan" to="/scan"/></node><node if="$(arg use_rviz)" pkg="rviz" type="rviz" name="rviz" args="-d $(find community_slam)/rviz/slam_mapping.rviz"/></launch>
