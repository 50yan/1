<launch><arg name="use_rviz" default="true"/><node pkg="move_base" type="move_base" name="move_base" output="screen"><rosparam file="$(find community_navigation)/config/costmap_common.yaml" command="load" ns="global_costmap"/><rosparam file="$(find community_navigation)/config/costmap_common.yaml" command="load" ns="local_costmap"/><rosparam file="$(find community_navigation)/config/global_costmap.yaml" command="load"/><rosparam file="$(find community_navigation)/config/local_costmap.yaml" command="load"/><rosparam file="$(find community_navigation)/config/dwa_local_planner.yaml" command="load"/><rosparam file="$(find community_navigation)/config/move_base.yaml" command="load"/></node><node if="$(arg use_rviz)" pkg="rviz" type="rviz" name="rviz" args="-d $(find community_navigation)/rviz/navigation.rviz"/></launch>
