<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="wheel" params="name x y driven">
    <link name="${name}"><visual><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.075" length="0.045"/></geometry><material name="black"><color rgba="0.02 0.02 0.02 1"/></material></visual><collision><origin rpy="1.5708 0 0"/><geometry><cylinder radius="0.075" length="0.045"/></geometry></collision><inertial><mass value="0.35"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial></link>
    <joint name="${name}_joint" type="${driven}"><parent link="base_link"/><child link="${name}"/><origin xyz="${x} ${y} -0.035"/><axis xyz="0 1 0"/></joint>
  </xacro:macro>
  <xacro:macro name="patrol_base">
    <link name="base_footprint"/>
    <joint name="base_footprint_joint" type="fixed"><parent link="base_footprint"/><child link="base_link"/><origin xyz="0 0 0.16"/></joint>
    <link name="base_link"><visual><geometry><box size="0.68 0.42 0.16"/></geometry><material name="blue"><color rgba="0.05 0.22 0.75 1"/></material></visual><collision><geometry><box size="0.68 0.42 0.16"/></geometry></collision><inertial><mass value="7.0"/><inertia ixx="0.10" ixy="0" ixz="0" iyy="0.18" iyz="0" izz="0.22"/></inertial></link>
    <xacro:wheel name="left_rear_wheel" x="-0.23" y="0.245" driven="continuous"/><xacro:wheel name="right_rear_wheel" x="-0.23" y="-0.245" driven="continuous"/>
    <xacro:wheel name="left_front_wheel" x="0.23" y="0.245" driven="fixed"/><xacro:wheel name="right_front_wheel" x="0.23" y="-0.245" driven="fixed"/>
    <gazebo><plugin name="differential_drive_controller" filename="libgazebo_ros_diff_drive.so"><robotNamespace>/</robotNamespace><commandTopic>/cmd_vel</commandTopic><odometryTopic>odom</odometryTopic><odometryFrame>odom</odometryFrame><robotBaseFrame>base_footprint</robotBaseFrame><publishOdomTF>true</publishOdomTF><publishWheelTF>false</publishWheelTF><leftJoint>left_rear_wheel_joint</leftJoint><rightJoint>right_rear_wheel_joint</rightJoint><wheelSeparation>0.49</wheelSeparation><wheelDiameter>0.15</wheelDiameter><wheelAcceleration>2.0</wheelAcceleration><wheelTorque>10.0</wheelTorque><updateRate>50</updateRate></plugin></gazebo>
  </xacro:macro>
</robot>
