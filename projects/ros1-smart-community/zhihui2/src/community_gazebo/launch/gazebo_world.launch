<launch><arg name="gui" default="true"/><arg name="paused" default="false"/><arg name="world" default="$(find community_gazebo)/worlds/smart_community.world"/><param name="/use_sim_time" value="true"/><include file="$(find gazebo_ros)/launch/empty_world.launch"><arg name="world_name" value="$(arg world)"/><arg name="gui" value="$(arg gui)"/><arg name="paused" value="$(arg paused)"/></include></launch>
