<launch><arg name="gui" default="true"/><arg name="paused" default="false"/><arg name="run_perception" default="true"/><include file="$(find community_gazebo)/launch/gazebo_world.launch"><arg name="gui" value="$(arg gui)"/><arg name="paused" value="$(arg paused)"/></include><include file="$(find community_description)/launch/spawn_robot.launch"/><node pkg="community_gazebo" type="traffic_light_controller.py" name="traffic_light_controller" output="screen"/><include if="$(arg run_perception)" file="$(find community_perception)/launch/perception.launch"/></launch>
